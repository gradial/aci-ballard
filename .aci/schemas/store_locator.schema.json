{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "store_locator",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "hours": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "hours",
          "services"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "heading",
    "description",
    "image",
    "imageAlt",
    "stores"
  ],
  "additionalProperties": false
}
