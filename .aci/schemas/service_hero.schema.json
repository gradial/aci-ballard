{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service_hero",
  "type": "object",
  "properties": {
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "enum": [
        "overlay",
        "split"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "image",
    "imageAlt",
    "eyebrow",
    "heading",
    "description",
    "links"
  ],
  "additionalProperties": false
}
