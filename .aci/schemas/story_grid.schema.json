{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story_grid",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string"
    },
    "allLabel": {
      "type": "string"
    },
    "allHref": {
      "type": "string"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "readTime": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "readTime",
          "href"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "heading",
    "allLabel",
    "allHref",
    "stories"
  ],
  "additionalProperties": false
}
