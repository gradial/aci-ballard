{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baremetal.local/schemas/page.schema.json",
  "title": "bare-metal Page",
  "type": "object",
  "required": [
    "$type",
    "id",
    "status",
    "layout",
    "metadata",
    "regions"
  ],
  "additionalProperties": true,
  "properties": {
    "$type": {
      "const": "page"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "type": "string"
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/$defs/field_heroBlock"
            },
            {
              "$ref": "#/$defs/gear_gridBlock"
            },
            {
              "$ref": "#/$defs/process_stepsBlock"
            },
            {
              "$ref": "#/$defs/site_footerBlock"
            },
            {
              "$ref": "#/$defs/site_navigationBlock"
            },
            {
              "$ref": "#/$defs/working_standardBlock"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "baseBlock": {
      "type": "object",
      "required": [
        "id",
        "component",
        "props"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/baseBlock"
            }
          }
        }
      }
    },
    "damAssetRef": {
      "type": "object",
      "required": [
        "$type",
        "assetId"
      ],
      "additionalProperties": true,
      "properties": {
        "$type": {
          "const": "dam.assetRef"
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "staticAssetRef": {
      "type": "object",
      "required": [
        "$type",
        "src"
      ],
      "additionalProperties": true,
      "properties": {
        "$type": {
          "const": "static.assetRef"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "assetRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/damAssetRef"
        },
        {
          "$ref": "#/$defs/staticAssetRef"
        }
      ]
    },
    "field_heroBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "field_hero"
            },
            "props": {
              "type": "object",
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "primaryLabel": {
                  "type": "string"
                },
                "primaryHref": {
                  "type": "string"
                },
                "secondaryLabel": {
                  "type": "string"
                },
                "secondaryHref": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "tone": {
                  "default": "pine",
                  "type": "string",
                  "enum": [
                    "pine",
                    "cedar",
                    "canvas"
                  ]
                }
              },
              "required": [
                "eyebrow",
                "headline",
                "description",
                "tone"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "gear_gridBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "gear_grid"
            },
            "props": {
              "type": "object",
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "introduction": {
                  "type": "string"
                },
                "cards": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "number": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "details": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "href": {
                        "type": "string"
                      },
                      "linkLabel": {
                        "type": "string"
                      },
                      "tone": {
                        "default": "stone",
                        "type": "string",
                        "enum": [
                          "cedar",
                          "pine",
                          "stone"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "description",
                      "href",
                      "linkLabel",
                      "tone"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "heading",
                "cards"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "process_stepsBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "process_steps"
            },
            "props": {
              "type": "object",
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "introduction": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "number",
                      "title",
                      "description"
                    ],
                    "additionalProperties": false
                  }
                },
                "ctaLabel": {
                  "type": "string"
                },
                "ctaHref": {
                  "type": "string"
                }
              },
              "required": [
                "heading",
                "introduction",
                "steps"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "site_footerBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "site_footer"
            },
            "props": {
              "type": "object",
              "properties": {
                "brandLogo": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "additionalProperties": false
                },
                "statement": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string"
                            },
                            "href": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "href"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "links"
                    ],
                    "additionalProperties": false
                  }
                },
                "legalLinks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "href": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "href"
                    ],
                    "additionalProperties": false
                  }
                },
                "copyright": {
                  "type": "string"
                }
              },
              "required": [
                "brandLogo",
                "statement",
                "columns",
                "legalLinks",
                "copyright"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "site_navigationBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "site_navigation"
            },
            "props": {
              "type": "object",
              "properties": {
                "brandHref": {
                  "type": "string"
                },
                "brandLabel": {
                  "type": "string"
                },
                "brandLogo": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "additionalProperties": false
                },
                "navigation": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "href": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "href"
                    ],
                    "additionalProperties": false
                  }
                },
                "utility": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "href"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "brandHref",
                "brandLabel",
                "brandLogo",
                "navigation"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "working_standardBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/baseBlock"
        },
        {
          "properties": {
            "component": {
              "const": "working_standard"
            },
            "props": {
              "type": "object",
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "paragraphs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "linkLabel": {
                  "type": "string"
                },
                "linkHref": {
                  "type": "string"
                },
                "markSrc": {
                  "type": "string"
                },
                "markAlt": {
                  "type": "string"
                },
                "reversed": {
                  "type": "boolean"
                }
              },
              "required": [
                "eyebrow",
                "heading",
                "paragraphs",
                "facts"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
