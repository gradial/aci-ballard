{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_grid",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string"
    },
    "allLabel": {
      "type": "string"
    },
    "allHref": {
      "type": "string"
    },
    "columns": {
      "type": "string",
      "enum": [
        "2",
        "3",
        "4"
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "white",
        "paper"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "image",
          "imageAlt",
          "title",
          "href",
          "description",
          "price",
          "colors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "heading",
    "allLabel",
    "allHref",
    "products"
  ],
  "additionalProperties": false
}
