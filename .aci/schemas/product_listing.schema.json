{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_listing",
  "type": "object",
  "properties": {
    "breadcrumb": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "key"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "badge": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "image",
          "imageAlt",
          "title",
          "href",
          "description",
          "price",
          "colors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "breadcrumb",
    "heading",
    "description",
    "categories",
    "products"
  ],
  "additionalProperties": false
}
